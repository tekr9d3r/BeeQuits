# PayPal sandbox app (developer.paypal.com → Apps & Credentials → Sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
# Must be registered as a Return URL under the app's "Log in with PayPal" settings
PAYPAL_REDIRECT_URI=http://localhost:3000/api/auth/paypal/callback
# developer.paypal.com → your app → Webhooks → the webhook's ID
PAYPAL_WEBHOOK_ID=

# Spike: sandbox personal account that should RECEIVE a settle-up
SPIKE_PAYEE_EMAIL=

ANTHROPIC_API_KEY=
CHANNEL3_API_KEY=
DATABASE_URL=
# 32+ random chars for the session cookie (Render generates one)
SESSION_SECRET=
# Enables the seeded demo trip and the "view as" switcher
DEMO_MODE=true
# AG Studio licence (trial keys from ag-grid.com); read at build time
NEXT_PUBLIC_AG_STUDIO_LICENSE_KEY=
